SELECT distinct
	ci.cst_gndr,
	ca.gen,
	CASE WHEN ci.cst_gndr != 'unknown' THEN ci.cst_gndr --CRM is the master of the gender info
	ELSE COALESCE(ca.gen , 'unknown')-- COALESCE CHOOSES 'UNKNOWN' IF 'ca.gen' IS NULL
END AS new_gen
FROM silver.crm_cust_info ci
LEFT JOIN silver.erp_cust_az12 ca
ON  ci.cst_key = ca.cid
LEFT JOIN silver.erp_loc_a101 la
ON	ci.cst_key = la.cid
ORDER BY 1,2 
--checking for innacurate gender


